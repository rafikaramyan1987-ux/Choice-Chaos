{
  "name": "cozy-cafe",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Cozy Caf\u00e9 \u2014 a relaxing mobile-first caf\u00e9 cooking game.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:crazygames": "tsc --noEmit && vite build --mode crazygames",
    "zip": "node scripts/zip-dist.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test",
    "covers": "node scripts/covers.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "fflate": "^0.8.3",
    "globals": "^17.14.0",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
